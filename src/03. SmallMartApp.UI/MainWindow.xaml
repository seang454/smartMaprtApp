<Window x:Class="SmallMartApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SmallMartApp.UI.Views"
        xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
        mc:Ignorable="d"
        Title="Smart Mart Management System" 
        Height="800" Width="1280" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">

    <Window.Resources>
        <!-- DataTemplates for MVVM view switching -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosCheckoutViewModel}">
            <views:PosCheckoutView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductListViewModel}">
            <views:ProductListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
            <views:CategoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerViewModel}">
            <views:CustomerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupplierViewModel}">
            <views:SupplierView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftViewModel}">
            <views:ShiftView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar: Width 230 -->
            <ColumnDefinition Width="230"/>
            <!-- Main Content: Width * -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: Dark Navy -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,24,20,24">
                    <TextBlock Text="🏪" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SMART MART" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="POS &amp; Inventory" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu Buttons -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <Button Content="📊  Dashboard" Command="{Binding NavigateToDashboardCommand}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,4"
                            Background="#1E293B" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="🛒  POS Checkout" Command="{Binding NavigateToPosCommand}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,4"
                            Background="Transparent" Foreground="#CBD5E1" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="📦  Products &amp; Stock" Command="{Binding NavigateToProductsCommand}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,4"
                            Background="Transparent" Foreground="#CBD5E1" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="🏷️  Categories" Command="{Binding NavigateToCategoriesCommand}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,4"
                            Background="Transparent" Foreground="#CBD5E1" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="👥  Customer Loyalty" Command="{Binding NavigateToCustomersCommand}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,4"
                            Background="Transparent" Foreground="#CBD5E1" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="🚚  Suppliers" Command="{Binding NavigateToSuppliersCommand}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,4"
                            Background="Transparent" Foreground="#CBD5E1" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="🕒  Cashier Shift" Command="{Binding NavigateToShiftsCommand}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,4"
                            Background="Transparent" Foreground="#CBD5E1" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <!-- Footer Status -->
                <Border Grid.Row="2" Background="#1E293B" Padding="16,12" Margin="12,0,12,16" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="SQL Server Connected" Foreground="#10B981" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="localhost\SQLEXPRESS" Foreground="#64748B" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT AREA: Header + Dynamic Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,0">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Smart Mart Manager" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <TextBlock Text="👤 Logged in as: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentUserName}" FontWeight="Bold" FontSize="13" Foreground="#2563EB" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- DYNAMIC SCREEN CONTENT -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
