<Window x:Class="SmallMartApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SmallMartApp.UI.Views"
        mc:Ignorable="d"
        Title="Small Mart Management System (POS &amp; Inventory)" 
        Height="720" Width="1050" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen" Background="#F1F2F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏪" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Small Mart POS &amp; Inventory" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Ready • SQLite Active" Foreground="#2ECC71" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,6,10,10">
            <TabItem Header="🛒 POS Cashier Checkout" FontSize="14" FontWeight="SemiBold" Padding="16,8">
                <views:PosCheckoutView x:Name="PosView"/>
            </TabItem>
            <TabItem Header="📦 Inventory &amp; Stock" FontSize="14" FontWeight="SemiBold" Padding="16,8">
                <views:ProductListView x:Name="InventoryView"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
