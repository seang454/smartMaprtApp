<Application x:Class="SmallMartApp.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:views="clr-namespace:SmallMartApp.UI.Views"
             xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
             xmlns:helpers="clr-namespace:SmallMartApp.UI.Helpers"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Global Type Converters -->
        <helpers:EmptyToZeroConverter x:Key="EmptyToZeroConverter"/>

        <!-- DataTemplates for MVVM view switching -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosCheckoutViewModel}">
            <views:PosCheckoutView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductListViewModel}">
            <views:ProductListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
            <views:CategoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerViewModel}">
            <views:CustomerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupplierViewModel}">
            <views:SupplierView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftViewModel}">
            <views:ShiftView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserViewModel}">
            <views:UserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerPurchaseHistoryViewModel}">
            <views:CustomerPurchaseHistoryView />
        </DataTemplate>

    </Application.Resources>
</Application>
