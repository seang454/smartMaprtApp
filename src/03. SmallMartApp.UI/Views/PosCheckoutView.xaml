<UserControl x:Class="SmallMartApp.UI.Views.PosCheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PosCheckoutViewModel}"
             d:DesignHeight="600" d:DesignWidth="900" Background="#F8F9FA">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🛒 Cashier Checkout" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" Foreground="#2C3E50"/>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="16" Padding="8,6" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Add Item" Command="{Binding AddBarcodeCommand}" 
                            Background="#3498DB" Foreground="White" FontWeight="SemiBold" 
                            Padding="16,6" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0"/>
                </Grid>

                <DataGrid Grid.Row="2" ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowHeight="36" FontSize="14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=${0:F2}}" Width="70" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Qty" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="-" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Width="24" Height="24" Margin="2,0" Background="#E0E0E0" BorderThickness="0"/>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" FontWeight="Bold" Margin="6,0"/>
                                        <Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Width="24" Height="24" Margin="2,0" Background="#E0E0E0" BorderThickness="0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=${0:F2}}" Width="80" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Action" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="⚡ Quick Mock Barcode Test:" FontWeight="SemiBold" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="Coke (885012401)" Command="{Binding SimulateQuickScanCommand}" CommandParameter="885012401" Margin="0,0,6,6" Padding="8,4"/>
                        <Button Content="Water (885012402)" Command="{Binding SimulateQuickScanCommand}" CommandParameter="885012402" Margin="0,0,6,6" Padding="8,4"/>
                        <Button Content="Chips (885012403)" Command="{Binding SimulateQuickScanCommand}" CommandParameter="885012403" Margin="0,0,6,6" Padding="8,4"/>
                        <Button Content="Noodles (885012404)" Command="{Binding SimulateQuickScanCommand}" CommandParameter="885012404" Margin="0,0,6,6" Padding="8,4"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Payment Summary" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="#2C3E50"/>

                <Border Grid.Row="1" Background="#2C3E50" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="TOTAL DUE" Foreground="#BDC3C7" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat=${0:F2}}" Foreground="#2ECC71" FontSize="36" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Cash Received ($):" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="14"/>
                    <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" FontSize="20" FontWeight="Bold" Padding="8,6"/>
                </StackPanel>

                <Border Grid.Row="3" Background="#F1F2F6" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Change Due:" FontSize="12" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding ChangeGiven, StringFormat=${0:F2}}" FontSize="24" FontWeight="Bold" Foreground="#E67E22"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="0,12"/>

                <Button Grid.Row="5" Content="✅ Complete Sale &amp; Print" Command="{Binding CompleteSaleCommand}" 
                        Background="#27AE60" Foreground="White" FontSize="16" FontWeight="Bold" 
                        Padding="0,12" Margin="0,0,0,8" Cursor="Hand" BorderThickness="0"/>

                <Button Grid.Row="6" Content="Clear Cart" Command="{Binding ClearCartCommand}" 
                        Background="#E74C3C" Foreground="White" FontSize="13" 
                        Padding="0,8" Cursor="Hand" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
