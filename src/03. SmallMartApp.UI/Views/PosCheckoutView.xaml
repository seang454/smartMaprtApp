<UserControl x:Class="SmallMartApp.UI.Views.PosCheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PosCheckoutViewModel}"
             Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Cart & Barcode Scanner -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header & Customer Loyalty Phone Input -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="🛒 Shopping Cart" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    
                    <!-- Customer Phone Search -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Customer Phone:" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding CustomerPhoneInput, UpdateSourceTrigger=PropertyChanged}" Width="130" Padding="6,4" VerticalContentAlignment="Center"/>
                        <Button Content="🔍 Link" Command="{Binding LookupCustomerCommand}" Background="#3B82F6" Foreground="White" Padding="10,4" Margin="6,0,0,0" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>

                <!-- Barcode Input Box -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="16" Padding="12,8" VerticalContentAlignment="Center" 
                             ToolTip="Scan barcode with scanner or enter manually"/>
                    <Button Grid.Column="1" Content="Add Item" Command="{Binding AddBarcodeCommand}" 
                            Background="#3B82F6" Foreground="White" FontWeight="Bold" 
                            Padding="20,8" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0"/>
                </Grid>

                <!-- Cart Table -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowHeight="42" FontSize="14" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="*" FontWeight="SemiBold" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=${0:F2}}" Width="80" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Qty" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="-" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Width="26" Height="26" Margin="2,0" Background="#E2E8F0" BorderThickness="0" Cursor="Hand"/>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" FontWeight="Bold" Margin="8,0"/>
                                        <Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Width="26" Height="26" Margin="2,0" Background="#E2E8F0" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=${0:F2}}" Width="90" FontWeight="Bold" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Action" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Quick Test Barcodes -->
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="⚡ Quick Mock Barcode Test:" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="Coke (885012401)" Command="{Binding SimulateQuickScanCommand}" CommandParameter="885012401" Margin="0,0,8,6" Padding="10,5" Background="#F1F5F9" BorderThickness="0"/>
                        <Button Content="Water (885012402)" Command="{Binding SimulateQuickScanCommand}" CommandParameter="885012402" Margin="0,0,8,6" Padding="10,5" Background="#F1F5F9" BorderThickness="0"/>
                        <Button Content="Chips (885012403)" Command="{Binding SimulateQuickScanCommand}" CommandParameter="885012403" Margin="0,0,8,6" Padding="10,5" Background="#F1F5F9" BorderThickness="0"/>
                        <Button Content="Noodles (885012404)" Command="{Binding SimulateQuickScanCommand}" CommandParameter="885012404" Margin="0,0,8,6" Padding="10,5" Background="#F1F5F9" BorderThickness="0"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: Payment & Summary Panel Matching Image -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Payment Summary" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" Foreground="#0F172A"/>

                <!-- Total Due Card -->
                <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="TOTAL DUE" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat=${0:F2} USD}" Foreground="#10B981" FontSize="36" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Payment Method Toggles -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="💵 CASH" Command="{Binding SelectCashPaymentCommand}" 
                            Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="12,10" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="1" Content="📱 KHQR CODE" Command="{Binding SelectKhqrPaymentCommand}" 
                            Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="12,10" Margin="6,0,0,0" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Cash Received -->
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Cash Received ($):" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="14" Foreground="#334155"/>
                    <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" FontSize="22" FontWeight="Bold" Padding="10,6"/>
                </StackPanel>

                <!-- Change Due -->
                <Border Grid.Row="4" Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Change Due:" FontSize="12" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ChangeGiven, StringFormat=${0:F2}}" FontSize="26" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <!-- Status Message -->
                <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" 
                           Foreground="#E67E22" Margin="0,10"/>

                <!-- Action Buttons -->
                <Button Grid.Row="6" Content="✅ COMPLETE SALE &amp; PRINT" Command="{Binding CompleteSaleCommand}" 
                        Background="#16A34A" Foreground="White" FontSize="16" FontWeight="Bold" 
                        Padding="0,14" Margin="0,0,0,10" Cursor="Hand" BorderThickness="0"/>

                <Button Grid.Row="7" Content="Clear Cart" Command="{Binding ClearCartCommand}" 
                        Background="#EF4444" Foreground="White" FontSize="13" 
                        Padding="0,8" Cursor="Hand" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
