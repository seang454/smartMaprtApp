<UserControl x:Class="SmallMartApp.UI.Views.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:UserViewModel}"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0: Header & Filter Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Top KPI Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Register Staff Card -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Status Message Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Staff Directory Table & Pagination -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0. Header & Filter / Sort / Search Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️ " FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="Staff &amp; User Management" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A"/>
                </StackPanel>
                <TextBlock Text="Manage cashier and administrator accounts, assigned shifts, credentials, and access permissions" 
                           FontSize="12" Foreground="#64748B" Margin="28,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" 
                        Padding="8,0" Width="180" Margin="0,0,8,0" Height="38">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" Margin="4,0,6,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 FontSize="12" Foreground="#0F172A"/>
                    </Grid>
                </Border>

                <!-- Filter: Role -->
                <ComboBox ItemsSource="{Binding RoleFilters}" SelectedItem="{Binding SelectedRoleFilter}" 
                          Width="110" Height="38" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                <!-- Filter: Shift -->
                <ComboBox ItemsSource="{Binding ShiftFilters}" SelectedItem="{Binding SelectedShiftFilter}" 
                          Width="115" Height="38" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                <!-- Filter: Status -->
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" 
                          Width="115" Height="38" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                <!-- Sort Dropdown -->
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" 
                          Width="140" Height="38" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                <!-- Reset Button -->
                <Button Content="✕" Command="{Binding ResetFiltersCommand}" 
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#F1F5F9" Foreground="#475569" Height="38" Padding="12,0" Margin="0,0,8,0" FontSize="12"
                        ToolTip="Reset Filters"/>

                <!-- Refresh Button -->
                <Button Content="↻" Command="{Binding LoadUsersCommand}" 
                        Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Foreground="White" Height="38" Padding="14,0"
                        ToolTip="Refresh List"/>
            </StackPanel>
        </Grid>

        <!-- 1. Top KPI Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Staff -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,10,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL STAFF" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalStaffCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        <TextBlock Text="Registered system accounts" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="10" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Administrators -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,10,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ADMINISTRATORS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding AdminCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#4F46E5" Margin="0,4,0,0"/>
                        <TextBlock Text="Full access &amp; management" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="10" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Cashiers -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,10,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CASHIERS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding CashierCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#059669" Margin="0,4,0,0"/>
                        <TextBlock Text="POS terminal operators" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="10" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="💳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Active Accounts -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="16,14"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ACTIVE ACCOUNTS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ActiveStaffCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#0284C7" Margin="0,4,0,0"/>
                        <TextBlock Text="Enabled for login" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F0F9FF" CornerRadius="10" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="🟢" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Register New Staff Card -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="✨ Register New Staff Member" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Full Name -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="FULL NAME" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Role -->
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="ROLE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding NewRole}"
                                  Height="36" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="12"/>
                    </StackPanel>

                    <!-- Working Shift -->
                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                        <TextBlock Text="WORKING SHIFT" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableShifts}" SelectedItem="{Binding NewWorkingShift}"
                                  Height="36" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="12"/>
                    </StackPanel>

                    <!-- Register Button -->
                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                        <Button Content="+ Create Staff" Command="{Binding AddUserCommand}" 
                                Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White" Height="36" Padding="18,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Status Notification Banner -->
        <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" 
                CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ️ " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 4. Staff Directory Table (Full Height) -->
        <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="0" 
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" ItemsSource="{Binding Users}" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="16,12"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewColumnHeader">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0,10">
                                            <GridViewRowPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0E7FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <!-- ID -->
                            <GridViewColumn Header="ID" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id, StringFormat='#{0}'}" Foreground="#94A3B8" FontWeight="SemiBold" Margin="14,0,0,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- USER / STAFF NAME -->
                            <GridViewColumn Header="STAFF MEMBER" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Border Background="#F1F5F9" CornerRadius="16" Width="32" Height="32" Margin="0,0,10,0">
                                                <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- ROLE -->
                            <GridViewColumn Header="ROLE" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                            <Setter Property="Background" Value="#EEF2FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="💳 Cashier"/>
                                                            <Setter Property="Foreground" Value="#059669"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                    <Setter Property="Text" Value="🛡️ Admin"/>
                                                                    <Setter Property="Foreground" Value="#4F46E5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- WORKING SHIFT -->
                            <GridViewColumn Header="WORKING SHIFT" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⏰ " FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding WorkingShift}" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- STATUS -->
                            <GridViewColumn Header="STATUS" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="● Inactive"/>
                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="● Active"/>
                                                                    <Setter Property="Foreground" Value="#065F46"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- ACTIONS -->
                            <GridViewColumn Header="ACTIONS" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Edit Button -->
                                            <Button Command="{Binding DataContext.OpenEditUserCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" Width="30" Height="30" Margin="0,0,6,0" Cursor="Hand"
                                                    ToolTip="Edit Profile &amp; Role" Background="Transparent" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="EditBorder" Background="#EFF6FF" CornerRadius="6" Padding="6">
                                                            <TextBlock Text="✏️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="EditBorder" Property="Background" Value="#2563EB"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Toggle Active Status Button -->
                                            <Button Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" Width="30" Height="30" Margin="0,0,6,0" Cursor="Hand"
                                                    ToolTip="Toggle Active / Inactive" Background="Transparent" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ToggleBorder" Background="#F1F5F9" CornerRadius="6" Padding="6">
                                                            <TextBlock Text="🔄" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#CBD5E1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" Width="30" Height="30" Cursor="Hand"
                                                    ToolTip="Remove User" Background="Transparent" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="DelBorder" Background="#FEE2E2" CornerRadius="6" Padding="6">
                                                            <TextBlock Text="🗑️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="DelBorder" Property="Background" Value="#EF4444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Pagination Bar -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Showing X-Y of Z entries -->
                        <TextBlock Grid.Column="0" Text="{Binding PaginationInfo}" 
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                        <!-- Page Size Selector -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Rows per page:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" 
                                      Width="65" Height="30" FontSize="12" VerticalContentAlignment="Center"
                                      Background="White" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- Navigation Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⏮" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                    Width="30" Height="30" Margin="0,0,4,0" ToolTip="First Page"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                            <Button Content="◀" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                    Width="30" Height="30" Margin="0,0,6,0" ToolTip="Previous Page"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                            
                            <Border Background="#EFF6FF" CornerRadius="6" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageDisplay}" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                            </Border>

                            <Button Content="▶" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"
                                    Width="30" Height="30" Margin="0,0,4,0" ToolTip="Next Page"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                            <Button Content="⏭" Command="{Binding LastPageCommand}" IsEnabled="{Binding CanNextPage}"
                                    Width="30" Height="30" ToolTip="Last Page"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Edit User Modal Dialog Overlay -->
        <Grid Grid.RowSpan="5" Background="#990F172A" 
              Visibility="{Binding IsEditUserOpen, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="1000">
            <Border Background="White" CornerRadius="14" Padding="28,24" Width="480" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#EEF2FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="✏️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Edit Staff Member" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Modify account details, working shift, role permissions, or password" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Full Name -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="FULL NAME" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Role & Working Shift (Two Columns) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="ROLE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding EditRole}"
                                      Height="36" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="WORKING SHIFT" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableShifts}" SelectedItem="{Binding EditWorkingShift}"
                                      Height="36" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- Reset Password (Optional) -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="NEW PASSWORD (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditNewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        <TextBlock Text="Leave empty to keep existing password unchanged." FontSize="10" Foreground="#94A3B8" Margin="2,2,0,0"/>
                    </StackPanel>

                    <!-- Active Status Toggle -->
                    <StackPanel Margin="0,0,0,20">
                        <CheckBox Content="Account is Active (Allow login and shift operations)" 
                                  IsChecked="{Binding EditIsActive}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Modal Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseEditUserCommand}"
                                Style="{StaticResource ModernButtonStyle}" 
                                Background="#F1F5F9" Foreground="#475569" Height="40" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="✓ Save Changes" Command="{Binding SaveEditUserCommand}"
                                Style="{StaticResource ModernButtonStyle}" 
                                Background="#2563EB" Foreground="White" Height="40" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
