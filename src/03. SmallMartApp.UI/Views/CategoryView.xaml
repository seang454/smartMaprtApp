<UserControl x:Class="SmallMartApp.UI.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CategoryViewModel}"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Add Category Card -->
            <RowDefinition Height="Auto"/>
            <!-- Status Notification -->
            <RowDefinition Height="Auto"/>
            <!-- Table (Stretches Full Height) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Search / Sort Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏷️ " FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="Category Management" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A"/>
                </StackPanel>
                <TextBlock Text="Organize products into logical groups and store departments" 
                           FontSize="12" Foreground="#64748B" Margin="28,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" 
                        Padding="8,0" Width="200" Margin="0,0,8,0" Height="38">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" Margin="4,0,6,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 FontSize="12" Foreground="#0F172A"/>
                    </Grid>
                </Border>

                <!-- Sort Dropdown -->
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" 
                          Width="140" Height="38" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                <!-- Reset Button -->
                <Button Content="✕" Command="{Binding ResetFiltersCommand}" 
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#F1F5F9" Foreground="#475569" Height="38" Padding="12,0" Margin="0,0,8,0" FontSize="12"/>

                <!-- Refresh Button -->
                <Button Content="↻" Command="{Binding LoadCategoriesCommand}" 
                        Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Foreground="White" Height="38" Padding="12,0"/>
            </StackPanel>
        </Grid>

        <!-- 2. Add New Category Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="✨ Create New Category" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="CATEGORY NAME" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="DESCRIPTION" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <Button Content="+ Add Category" Command="{Binding AddCategoryCommand}" 
                                Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White" Height="36" Padding="20,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Status Notification -->
        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" 
                CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ️ " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 4. Category Table (Full Height) -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="0" 
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" ItemsSource="{Binding Categories}" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="16,12"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0,10">
                                        <GridViewRowPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E0E7FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" Foreground="#94A3B8" FontWeight="SemiBold" Margin="16,0,0,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="CATEGORY NAME" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#2563EB"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="DESCRIPTION" Width="500">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Action (Edit & Delete) -->
                        <GridViewColumn Header="ACTIONS" Width="95">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Edit Button -->
                                        <Button Command="{Binding DataContext.OpenEditCategoryCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" Width="30" Height="30" Cursor="Hand" Margin="0,0,6,0"
                                                ToolTip="Edit Category" Background="Transparent" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="EditBorder" Background="#EFF6FF" CornerRadius="6" Padding="6">
                                                        <TextBlock Text="✏️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="EditBorder" Property="Background" Value="#BFDBFE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Delete Button -->
                                        <Button Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" Width="30" Height="30" Cursor="Hand"
                                                ToolTip="Delete Category" Background="Transparent" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DelBorder" Background="#FEE2E2" CornerRadius="6" Padding="6">
                                                        <TextBlock Text="🗑️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DelBorder" Property="Background" Value="#EF4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Pagination Bar -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Showing X-Y of Z entries -->
                    <TextBlock Grid.Column="0" Text="{Binding PaginationInfo}" 
                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                    <!-- Page Size Selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Rows per page:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" 
                                  Width="65" Height="30" FontSize="12" VerticalContentAlignment="Center"
                                  Background="White" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Navigation Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⏮" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                Width="30" Height="30" Margin="0,0,4,0" ToolTip="First Page"
                                Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                        <Button Content="◀" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                Width="30" Height="30" Margin="0,0,6,0" ToolTip="Previous Page"
                                Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                        
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageDisplay}" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                        </Border>

                        <Button Content="▶" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"
                                Width="30" Height="30" Margin="0,0,4,0" ToolTip="Next Page"
                                Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                        <Button Content="⏭" Command="{Binding LastPageCommand}" IsEnabled="{Binding CanNextPage}"
                                Width="30" Height="30" ToolTip="Last Page"
                                Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

        <!-- Edit Category Modal Dialog -->
        <Grid Grid.RowSpan="4" Background="#990F172A" 
              Visibility="{Binding IsEditCategoryOpen, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="1000">
            <Border Background="White" CornerRadius="14" Padding="28,24" Width="460" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#EFF6FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="✏️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Edit Category" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Update department label and description" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="CATEGORY NAME" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditCategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="DESCRIPTION" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseEditCategoryCommand}"
                                Style="{StaticResource ModernButtonStyle}" 
                                Background="#F1F5F9" Foreground="#475569" Height="40" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="✓ Save Changes" Command="{Binding SaveEditCategoryCommand}"
                                Style="{StaticResource ModernButtonStyle}" 
                                Background="#2563EB" Foreground="White" Height="40" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
