<UserControl x:Class="SmallMartApp.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Store Analytics Dashboard" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
            <Button Content="🔄 Refresh Data" Command="{Binding LoadDashboardCommand}" DockPanel.Dock="Right" 
                    HorizontalAlignment="Right" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" 
                    Padding="14,8" BorderThickness="0" Cursor="Hand"/>
        </DockPanel>

        <!-- 4 KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Today's Revenue -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Today's Revenue" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TodayRevenue, StringFormat=${0:F2}}" Foreground="#0F172A" FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                    <TextBlock Text="Live from SQL Server" Foreground="#10B981" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Transactions -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Sales Volume" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TodayTransactions}" Foreground="#0F172A" FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                    <TextBlock Text="Orders completed today" Foreground="#64748B" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Active Shift -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Active Shift Cashier" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveShiftCashier}" Foreground="#2563EB" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/>
                    <TextBlock Text="Cash Drawer Ready" Foreground="#10B981" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Low Stock Warnings -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Low Stock Warnings" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LowStockWarningsCount}" Foreground="#EF4444" FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                    <TextBlock Text="Items require reordering" Foreground="#EF4444" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Two Columns: Recent Sales Log + Low Stock Alerts Table -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Recent Sales Log -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,16,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Recent Sales Transactions Log" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentSales}" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt #" Binding="{Binding ReceiptNumber}" Width="160" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt, StringFormat=HH:mm:ss}" Width="80"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=${0:F2}}" Width="90" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="90"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding ChangeGiven, StringFormat=${0:F2}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Low Stock Alert List -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="⚠️ Low Stock Alert List" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="60" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Alert Limit" Binding="{Binding LowStockAlertThreshold}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
