<Window x:Class="SmallMartApp.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="Smart Mart - Welcome &amp; Sign In" 
        Height="620" Width="980" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanMinimize"
        Background="#0F172A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="ModernFlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Hero Section: 440px -->
            <ColumnDefinition Width="440"/>
            <!-- Right Interactive Section: * -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- LEFT HERO: Brand & Feature Highlights                    -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" Background="#0B132B" Padding="36" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#2563EB" CornerRadius="12" Width="44" Height="44" Margin="0,0,12,0">
                            <TextBlock Text="🏪" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SMART MART" FontSize="20" FontWeight="ExtraBold" Foreground="White"/>
                            <TextBlock Text="Enterprise POS &amp; Inventory ERP" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Fast, reliable supermarket management designed for high-traffic retail checkout."
                               FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>
                </StackPanel>

                <!-- 4 Feature Highlight Cards -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
                    <!-- Feature 1 -->
                    <Border Background="#131F42" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="High-Speed POS Checkout" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <TextBlock Text="Barcode scanning &amp; instant change math" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Feature 2 -->
                    <Border Background="#131F42" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Real-Time Analytics" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <TextBlock Text="Live revenue, profit margins &amp; low stock alerts" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Feature 3 -->
                    <Border Background="#131F42" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Cashier Drawer Balancing" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <TextBlock Text="Starting floats &amp; shift discrepancy audit logs" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Feature 4 -->
                    <Border Background="#131F42" CornerRadius="10" Padding="14,10" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Customer Loyalty &amp; Rewards" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <TextBlock Text="Phone number lookup and points system" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer Status -->
                <Border Grid.Row="2" Background="#131F42" CornerRadius="8" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🟢 " FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="SQL Server Connected (localhost\SQLEXPRESS)" Foreground="#10B981" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- RIGHT PANEL: Welcome Screen OR Sign In Form              -->
        <!-- ======================================================== -->
        <Border Grid.Column="1" Background="White" Padding="48">
            <Grid VerticalAlignment="Center">
                
                <!-- ======================================== -->
                <!-- STATE 1: WELCOME SCREEN (Initial View)    -->
                <!-- ======================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoginFormVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Background="#EFF6FF" CornerRadius="16" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <TextBlock Text="👋" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Welcome to Smart Mart" FontSize="26" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                    <TextBlock Text="Please sign in to open your cashier register or access the management dashboard." 
                               FontSize="14" Foreground="#64748B" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,28"/>

                    <!-- Big Call To Action Button -->
                    <Button Content="🔐  Sign In to Smart Mart" 
                            Command="{Binding ShowLoginFormCommand}"
                            Style="{StaticResource ModernFlatButtonStyle}"
                            Background="#2563EB" Foreground="White" 
                            Height="50" FontSize="15" Margin="0,0,0,24"/>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🛡️ Role-Based Access Control:" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBlock Text="• Cashiers: Access POS checkout &amp; active shift drawer." FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="• Managers: Full analytics, inventory, and supplier control." FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================================== -->
                <!-- STATE 2: POP-IN SIGN IN FORM             -->
                <!-- ======================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoginFormVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Back to Welcome Link -->
                    <Button Content="← Back to Welcome" Command="{Binding BackToWelcomeCommand}" 
                            HorizontalAlignment="Left" Background="Transparent" Foreground="#64748B" 
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,16"/>

                    <TextBlock Text="Sign In to Your Account" FontSize="24" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                    <TextBlock Text="Enter your credentials to start your session" FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>

                    <!-- Error Alert -->
                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Username Field -->
                    <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14"/>

                    <!-- Password Field -->
                    <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,20"/>

                    <!-- Sign In Submit Button -->
                    <Button Content="Sign In  ➔" 
                            Command="{Binding LoginCommand}"
                            IsDefault="True"
                            Style="{StaticResource ModernFlatButtonStyle}"
                            Background="#2563EB" Foreground="White" 
                            Height="46" FontSize="14" Margin="0,0,0,20"/>

                    <!-- One-Click Quick Demo Access for Grading -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⚡ Quick Demo One-Click Access:" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2" Rows="1">
                                <Button Content="👑 Manager / Admin" Command="{Binding QuickLoginAdminCommand}" 
                                        Style="{StaticResource ModernFlatButtonStyle}"
                                        Background="#1E293B" Foreground="White" Height="34" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="🛒 Cashier Register" Command="{Binding QuickLoginCashierCommand}" 
                                        Style="{StaticResource ModernFlatButtonStyle}"
                                        Background="#10B981" Foreground="White" Height="34" FontSize="11" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
