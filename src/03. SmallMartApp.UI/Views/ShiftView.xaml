<UserControl x:Class="SmallMartApp.UI.Views.ShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ShiftViewModel}"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0. Header & Metrics -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Drawer Action Cards (Start & Close Shift) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Status Notification -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Multi-Criteria Filter & Sort Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Shift Audit Log Table (Stretches Full Height) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. SCREEN HEADER & QUICK METRICS                         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle based on Role -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👥 " FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Cashier Shift &amp; Drawer Reconciliation"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Text" Value="Staff Shifts &amp; Drawer Audits"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock FontSize="12" Foreground="#64748B" Margin="28,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Manage cashier drawer floats, cash reconciliation, and shift audit logs"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Text" Value="Audit employee work shifts, monitor drawer cash floats, and track discrepancies"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Metric Summary Badges & Refresh -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Total Shifts Badge -->
                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total: " FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                        <TextBlock Text="{Binding TotalShiftsCount}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <!-- Open Shifts Badge -->
                <Border Background="#ECFDF5" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🟢 Open: " FontSize="11" Foreground="#059669" FontWeight="Medium"/>
                        <TextBlock Text="{Binding OpenShiftsCount}" FontSize="12" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                </Border>

                <!-- Closed Shifts Badge -->
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒 Closed: " FontSize="11" Foreground="#2563EB" FontWeight="Medium"/>
                        <TextBlock Text="{Binding ClosedShiftsCount}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <!-- Refresh Button -->
                <Button Content="↻ Refresh Shifts" Command="{Binding RefreshShiftCommand}" 
                        Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Foreground="White" Height="38"/>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1. DRAWER ACTION CARDS (Start & Close Shift)             -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card A: Open New Shift -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20,16" 
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#ECFDF5" CornerRadius="6" Padding="6,3" Margin="0,0,8,0">
                            <TextBlock Text="🟢" FontSize="10"/>
                        </Border>
                        <TextBlock Text="Start New Shift" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Starting Drawer Float ($):" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding StartingCashInput, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToZeroConverter}, StringFormat='{}{0:F2}'}" 
                             Style="{StaticResource ModernTextBoxStyle}" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Button Content="● Open Shift" Command="{Binding OpenShiftCommand}" 
                            Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White" Height="40" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Card B: Close Shift -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20,16" 
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#FEF2F2" CornerRadius="6" Padding="6,3" Margin="0,0,8,0">
                            <TextBlock Text="🔴" FontSize="10"/>
                        </Border>
                        <TextBlock Text="Close Active Shift" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Counted Actual Cash ($):" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ActualCashInput, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToZeroConverter}, StringFormat='{}{0:F2}'}" 
                             Style="{StaticResource ModernTextBoxStyle}" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Button Content="● Close Shift &amp; Reconcile" Command="{Binding CloseShiftCommand}" 
                            Style="{StaticResource ModernButtonStyle}" Background="#DC2626" Foreground="White" Height="40" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. STATUS NOTIFICATION                                   -->
        <!-- ======================================================== -->
        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" 
                CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ️ " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. MULTI-CRITERIA FILTER & SORT TOOLBAR                  -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,12"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search Input: 180px -->
                    <ColumnDefinition Width="180"/>
                    <!-- Role Filter: 120px -->
                    <ColumnDefinition Width="120"/>
                    <!-- Status Filter: 120px -->
                    <ColumnDefinition Width="120"/>
                    <!-- WorkingShift Filter: 130px -->
                    <ColumnDefinition Width="135"/>
                    <!-- Cash Comparison: 175px -->
                    <ColumnDefinition Width="180"/>
                    <!-- Sort By: 175px -->
                    <ColumnDefinition Width="180"/>
                    <!-- Reset Button: Auto -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Search Box -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="SEARCH STAFF / SHIFT #" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" Height="34" FontSize="12"/>
                </StackPanel>

                <!-- 2. Role Filter -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="ROLE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding RoleFilterOptions}" 
                              SelectedItem="{Binding SelectedRoleFilter}"
                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                </StackPanel>

                <!-- 3. Status Filter -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}" 
                              SelectedItem="{Binding SelectedStatusFilter}"
                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                </StackPanel>

                <!-- 4. Working Shift Filter -->
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="WORKING SHIFT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ShiftFilterOptions}" 
                              SelectedItem="{Binding SelectedShiftFilter}"
                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                </StackPanel>

                <!-- 5. Cash Amount Filter -->
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="CASH RECONCILIATION" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CashFilterOptions}" 
                              SelectedItem="{Binding CashComparisonFilter}"
                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                </StackPanel>

                <!-- 6. Sort By -->
                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="SORT BY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SortOptions}" 
                              SelectedItem="{Binding SelectedSortOption}"
                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                </StackPanel>

                <!-- 7. Reset Filters Button -->
                <StackPanel Grid.Column="6" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Button Content="Reset" Command="{Binding ResetFiltersCommand}" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Background="#F1F5F9" Foreground="#475569" Height="34" FontSize="12" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 4. SHIFT AUDIT LOG TABLE (Full Height)                   -->
        <!-- ======================================================== -->
        <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="0" 
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" ItemsSource="{Binding FilteredShifts}" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,12"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0,8">
                                        <GridViewRowPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E0E7FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView>
                        <!-- 1. Shift # -->
                        <GridViewColumn Header="SHIFT #" Width="75">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id, StringFormat='#{0}'}" Foreground="#94A3B8" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 2. Staff / Cashier (FullName + @Username) -->
                        <GridViewColumn Header="STAFF / USER" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CashierName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding Username}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 3. Role Badge Column -->
                        <GridViewColumn Header="ROLE" Width="95">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdminRole}" Value="True">
                                                        <Setter Property="Background" Value="#EEF2FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RoleBadge}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#059669"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdminRole}" Value="True">
                                                            <Setter Property="Foreground" Value="#4F46E5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 4. Working Shift Badge -->
                        <GridViewColumn Header="WORKING SHIFT" Width="115">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding WorkingShiftBadge}" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 5. Start Time -->
                        <GridViewColumn Header="START TIME" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 6. End Time -->
                        <GridViewColumn Header="END TIME" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EndTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 7. Starting Drawer Float -->
                        <GridViewColumn Header="START FLOAT" Width="95">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartingCash, StringFormat='${0:F2}'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Shift Customer Sales Total -->
                        <GridViewColumn Header="SHIFT SALES" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalSalesDisplay}" FontWeight="Bold" FontSize="12" Foreground="#047857"/>
                                        <TextBlock Text="{Binding PaymentBreakdownDisplay}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 8. Expected Cash -->
                        <GridViewColumn Header="EXPECTED" Width="95">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExpectedCash, StringFormat='${0:F2}'}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 9. Actual Cash (Counted at Shift Close) -->
                        <GridViewColumn Header="ACTUAL" Width="95">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActualCashDisplay}" FontWeight="Bold" FontSize="12" Foreground="#2563EB" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 10. Discrepancy (Over / Shortage) -->
                        <GridViewColumn Header="DISCREPANCY" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DiscrepancyDisplay}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasShortage}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasSurplus}" Value="True">
                                                        <Setter Property="Foreground" Value="#2563EB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 11. Status Badge -->
                        <GridViewColumn Header="STATUS" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="#059669"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Pagination Bar -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Showing X-Y of Z entries -->
                    <TextBlock Grid.Column="0" Text="{Binding PaginationInfo}" 
                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                    <!-- Page Size Selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Rows per page:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" 
                                  Width="65" Height="30" FontSize="12" VerticalContentAlignment="Center"
                                  Background="White" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Navigation Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⏮" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                Width="30" Height="30" Margin="0,0,4,0" ToolTip="First Page"
                                Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                        <Button Content="◀" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                Width="30" Height="30" Margin="0,0,6,0" ToolTip="Previous Page"
                                Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                        
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageDisplay}" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                        </Border>

                        <Button Content="▶" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"
                                Width="30" Height="30" Margin="0,0,4,0" ToolTip="Next Page"
                                Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                        <Button Content="⏭" Command="{Binding LastPageCommand}" IsEnabled="{Binding CanNextPage}"
                                Width="30" Height="30" ToolTip="Last Page"
                                Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
    </Grid>
</UserControl>
