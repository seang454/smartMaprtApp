<UserControl x:Class="SmallMartApp.UI.Views.CustomerPurchaseHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CustomerPurchaseHistoryViewModel}"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ======================================================== -->
        <!-- MAIN PURCHASE HISTORY WORKSPACE                          -->
        <!-- ======================================================== -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- 0: Header & Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Top KPI Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Status Feedback Banner -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Orders Directory Table & Pagination -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0. Header & Search / Filter Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Page Title & Subtitle -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾 " FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Customer Purchases &amp; Receipts" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock Text="Browse customer transaction history, reprint official receipts, and audit order payment methods" 
                               FontSize="12" Foreground="#64748B" Margin="28,2,0,0"/>
                </StackPanel>

                <!-- Search, Filters, Sort, and Refresh Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" 
                            Padding="8,0" Width="200" Margin="0,0,8,0" Height="38">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" Margin="4,0,6,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                     FontSize="12" Foreground="#0F172A"/>
                        </Grid>
                    </Border>

                    <!-- Payment Filter -->
                    <ComboBox ItemsSource="{Binding PaymentFilters}" SelectedItem="{Binding SelectedPaymentFilter}" 
                              Width="120" Height="38" Margin="0,0,8,0"
                              VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                    <!-- Customer Filter -->
                    <ComboBox ItemsSource="{Binding CustomerFilters}" SelectedItem="{Binding SelectedCustomerFilter}" 
                              Width="135" Height="38" Margin="0,0,8,0"
                              VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                    <!-- Date Filter -->
                    <ComboBox ItemsSource="{Binding DateFilters}" SelectedItem="{Binding SelectedDateFilter}" 
                              Width="110" Height="38" Margin="0,0,8,0"
                              VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                    <!-- Sort By -->
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" 
                              Width="150" Height="38" Margin="0,0,8,0"
                              VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                    <!-- Reset Button -->
                    <Button Content="✕" Command="{Binding ResetFiltersCommand}" 
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#F1F5F9" Foreground="#475569" Height="38" Padding="12,0" Margin="0,0,8,0" FontSize="12"
                            ToolTip="Reset Filters"/>

                    <!-- Refresh Button -->
                    <Button Content="↻" Command="{Binding LoadSalesHistoryCommand}" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Background="#2563EB" Foreground="White" Height="38" Padding="14,0"
                            ToolTip="Refresh Orders"/>
                </StackPanel>
            </Grid>

            <!-- 1. Top KPI Summary Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Total Orders -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL ORDERS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalOrdersCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                            <TextBlock Text="Recorded receipts" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Center">
                            <TextBlock Text="🧾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 2: Total Revenue -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL REVENUE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat='${0:F2}'}" FontSize="20" FontWeight="ExtraBold" Foreground="#059669" Margin="0,4,0,0"/>
                            <TextBlock Text="Gross customer spend" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Center">
                            <TextBlock Text="💰" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 3: Cash Sales -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CASH SALES" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalCashSales, StringFormat='${0:F2}'}" FontSize="20" FontWeight="ExtraBold" Foreground="#0284C7" Margin="0,4,0,0"/>
                            <TextBlock Text="Drawer cash received" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F0F9FF" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Center">
                            <TextBlock Text="💵" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 4: KHQR Sales -->
                <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BAKONG KHQR" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalKhqrSales, StringFormat='${0:F2}'}" FontSize="20" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,4,0,0"/>
                            <TextBlock Text="Digital bank scan" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Center">
                            <TextBlock Text="📱" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 5: Member Orders -->
                <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="16,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MEMBER ORDERS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding MemberOrdersCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                            <TextBlock Text="Loyalty points earned" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F5F3FF" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Status Notification Banner -->
            <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" 
                    CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️ " VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 3. Purchases Directory Table (Full Height) -->
            <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="0" 
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0" ItemsSource="{Binding FilteredSales}" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewColumnHeader">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0,8">
                                                <GridViewRowPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>

                        <ListView.View>
                            <GridView>
                                <!-- RECEIPT NUMBER -->
                                <GridViewColumn Header="RECEIPT #" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding ReceiptNumber}" FontWeight="Bold" FontSize="11" Foreground="#334155"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- DATE / TIME -->
                                <GridViewColumn Header="DATE &amp; TIME" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ShortDate}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- CUSTOMER -->
                                <GridViewColumn Header="CUSTOMER" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="🚶 "/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasCustomer}" Value="True">
                                                                        <Setter Property="Text" Value="👤 "/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding CustomerName}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CustomerPhone}" FontSize="11" Foreground="#64748B" Margin="16,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCustomer}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- CASHIER / STAFF -->
                                <GridViewColumn Header="CASHIER" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CashierName}" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                                                <TextBlock Text="{Binding ShiftDisplay}" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- ITEMS COUNT -->
                                <GridViewColumn Header="ITEMS" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ItemsCountDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- TOTAL PAID -->
                                <GridViewColumn Header="TOTAL PAID" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalDisplay}" FontWeight="ExtraBold" FontSize="13" Foreground="#059669"/>
                                                <TextBlock Text="{Binding DiscountDisplay, StringFormat='Disc: {0}'}" FontSize="10" Foreground="#D97706">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DiscountAmount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- PAYMENT METHOD -->
                                <GridViewColumn Header="METHOD" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKhqr}" Value="True">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="💵 Cash"/>
                                                                <Setter Property="Foreground" Value="#065F46"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsKhqr}" Value="True">
                                                                        <Setter Property="Text" Value="📱 KHQR"/>
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- ACTIONS: PRINT RECEIPT & VIEW ORDER -->
                                <GridViewColumn Header="ACTIONS" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Print Receipt Button (Available to ALL Roles) -->
                                                <Button Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ModernButtonStyle}"
                                                        Background="#F1F5F9" Foreground="#1E293B" Height="30" Padding="10,0" Margin="0,0,6,0"
                                                        ToolTip="Print Customer Receipt">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🖨️ " FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Print" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- View Order Details Button -->
                                                <Button Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ModernButtonStyle}"
                                                        Background="#EFF6FF" Foreground="#2563EB" Height="30" Padding="10,0"
                                                        ToolTip="View Order Items &amp; Audit Details">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="👁️ " FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Details" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Pagination Bar -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Showing X-Y of Z entries -->
                            <TextBlock Grid.Column="0" Text="{Binding PaginationInfo}" 
                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                            <!-- Page Size Selector -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Rows per page:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" 
                                          Width="65" Height="30" FontSize="12" VerticalContentAlignment="Center"
                                          Background="White" BorderBrush="#CBD5E1"/>
                            </StackPanel>

                            <!-- Navigation Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⏮" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                        Width="30" Height="30" Margin="0,0,4,0" ToolTip="First Page"
                                        Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                                <Button Content="◀" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                        Width="30" Height="30" Margin="0,0,6,0" ToolTip="Previous Page"
                                        Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                                
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PageDisplay}" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                                </Border>

                                <Button Content="▶" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"
                                        Width="30" Height="30" Margin="0,0,4,0" ToolTip="Next Page"
                                        Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                                <Button Content="⏭" Command="{Binding LastPageCommand}" IsEnabled="{Binding CanNextPage}"
                                        Width="30" Height="30" ToolTip="Last Page"
                                        Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ORDER DETAILS & RECEIPT MODAL DIALOG                     -->
        <!-- ======================================================== -->
        <Grid Background="#990F172A" 
              Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="1500">
            <Border Background="White" CornerRadius="16" Width="520" MaxHeight="620" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="30" ShadowDepth="10" Opacity="0.35" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="15,15,0,0" Padding="20,16">
                        <DockPanel>
                            <Button Content="✕" Command="{Binding CloseDetailCommand}"
                                    DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Foreground="#94A3B8" Background="Transparent" BorderThickness="0"
                                    FontSize="16" FontWeight="Bold" Cursor="Hand" Width="28" Height="28"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#2563EB" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="RECEIPT" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedSale.ReceiptNumber}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedSale.FormattedDate, StringFormat='Ordered: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Modal Body (Scrollable items + summary) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <StackPanel>
                            <!-- Customer & Cashier Info Row -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Customer Details -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="CUSTOMER" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedSale.CustomerName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding SelectedSale.CustomerPhone}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cashier Details -->
                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="STAFF &amp; SHIFT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedSale.CashierName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding SelectedSale.ShiftDisplay}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Items Table Header -->
                            <TextBlock Text="ITEMS PURCHASED" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PRODUCT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="QTY" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="PRICE" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Items List -->
                            <ItemsControl ItemsSource="{Binding SelectedSale.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="12" Foreground="#475569" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='${0:F2}'}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Subtotal, StringFormat='${0:F2}'}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Payment & Balance Summary Card -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Discount Applied:" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedSale.DiscountDisplay}" FontSize="12" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Payment Method:" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedSale.PaymentMethodDisplay}" FontSize="12" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Amount Tendered:" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedSale.CashReceived, StringFormat='${0:F2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Change Given:" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedSale.ChangeGiven, StringFormat='${0:F2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="#E2E8F0" Margin="0,8"/>
                                    <Grid>
                                        <TextBlock Text="TOTAL PAID:" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding SelectedSale.TotalDisplay}" FontSize="18" FontWeight="ExtraBold" Foreground="#059669" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Actions Footer -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" CornerRadius="0,0,15,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Close" Command="{Binding CloseDetailCommand}"
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="#E2E8F0" Foreground="#475569" Height="42" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="🖨️ Print Receipt" 
                                    Command="{Binding PrintReceiptCommand}" CommandParameter="{Binding SelectedSale}"
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="#2563EB" Foreground="White" Height="42" Margin="6,0,0,0" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
