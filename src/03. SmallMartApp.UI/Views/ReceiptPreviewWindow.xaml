<Window x:Class="SmallMartApp.UI.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermal Receipt Simulator"
        Width="440"
        Height="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.5" Direction="270" ShadowDepth="8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Window Header (Draggable) -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="16,16,0,0" Padding="18,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="🖨️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Virtual POS Receipt Printer" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock Text="80mm Thermal Paper Simulator" FontSize="10" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close 'X' Button -->
                    <Button Content="✕" 
                            Click="Close_Click"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Foreground="#94A3B8"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#334155"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Scrollable Receipt Paper Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                <!-- Authentic Thermal Receipt Paper Container -->
                <Border x:Name="ReceiptPaperBorder" 
                        Background="#FFFFFF" 
                        Width="360"
                        CornerRadius="4" 
                        Padding="20,24"
                        BorderBrush="#CBD5E1" 
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.15" Direction="270" ShadowDepth="4"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Top Perforated Tear Indicator -->
                        <TextBlock Text="• • • • • • • • • • • • • • • • • • • • • • • • • • • • • • • • •" 
                                   Foreground="#94A3B8" HorizontalAlignment="Center" FontSize="9" Margin="0,0,0,12"/>

                        <!-- Store Header -->
                        <TextBlock x:Name="TxtStoreName" Text="SMART MART SUPERMARKET" 
                                   FontFamily="Consolas" FontWeight="ExtraBold" FontSize="16" 
                                   Foreground="#0F172A" HorizontalAlignment="Center" TextAlignment="Center"/>
                        
                        <TextBlock Text="Express Retail &amp; Grocery POS" 
                                   FontFamily="Consolas" FontSize="11" Foreground="#475569" 
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>

                        <TextBlock Text="Russian Blvd, Toul Kork, Phnom Penh" 
                                   FontFamily="Consolas" FontSize="10" Foreground="#64748B" 
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>

                        <TextBlock Text="Tel: +855 23 888 999 | Tax ID: K001-9021882" 
                                   FontFamily="Consolas" FontSize="10" Foreground="#64748B" 
                                   HorizontalAlignment="Center" Margin="0,2,0,10"/>

                        <TextBlock Text="================================================" 
                                   FontFamily="Consolas" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>

                        <!-- Metadata Section -->
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Date/Time: " FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtDate" Text="2026-09-26 02:50:00" FontFamily="Consolas" FontSize="11" Foreground="#0F172A"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Receipt #: " FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtReceiptNo" Text="SM-20260926-0001" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Cashier:   " FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtCashier" Text="Staff Cashier" FontFamily="Consolas" FontSize="11" Foreground="#0F172A"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Customer:  " FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtCustomer" Text="Walk-in Guest" FontFamily="Consolas" FontSize="11" Foreground="#0F172A"/>
                        </Grid>

                        <TextBlock Text="------------------------------------------------" 
                                   FontFamily="Consolas" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>

                        <!-- Table Column Headers -->
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ITEM" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                            <TextBlock Grid.Column="1" Text="QTY" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0F172A" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="PRICE" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0F172A" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="TOTAL" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0F172A" TextAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="------------------------------------------------" 
                                   FontFamily="Consolas" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>

                        <!-- Line Items List -->
                        <ItemsControl x:Name="ItemsList" Margin="0,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ItemName}" FontFamily="Consolas" FontSize="11" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Qty}" FontFamily="Consolas" FontSize="11" Foreground="#1E293B" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PriceDisplay}" FontFamily="Consolas" FontSize="11" Foreground="#1E293B" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SubtotalDisplay}" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0F172A" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="------------------------------------------------" 
                                   FontFamily="Consolas" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,4"/>

                        <!-- Financial Summary -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="SUBTOTAL:" FontFamily="Consolas" FontSize="11" Foreground="#475569"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSubtotal" Text="$0.00" FontFamily="Consolas" FontSize="11" Foreground="#475569" TextAlignment="Right"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="VAT (0% Included):" FontFamily="Consolas" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="$0.00" FontFamily="Consolas" FontSize="10" Foreground="#94A3B8" TextAlignment="Right"/>

                            <!-- GRAND TOTAL -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="GRAND TOTAL:" FontFamily="Consolas" FontWeight="ExtraBold" FontSize="14" Foreground="#0F172A" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtTotalAmount" Text="$0.00" FontFamily="Consolas" FontWeight="ExtraBold" FontSize="15" Foreground="#0F172A" TextAlignment="Right" Margin="0,4,0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="TENDERED / CASH:" FontFamily="Consolas" FontSize="11" Foreground="#475569"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtCashGiven" Text="$0.00" FontFamily="Consolas" FontSize="11" Foreground="#475569" TextAlignment="Right"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="CHANGE DUE:" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#059669" Margin="0,2,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtChange" Text="$0.00" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#059669" TextAlignment="Right" Margin="0,2,0,0"/>
                        </Grid>

                        <TextBlock Text="================================================" 
                                   FontFamily="Consolas" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,6"/>

                        <!-- Simulated Barcode Graphic -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,4">
                            <!-- Visual Barcode Lines -->
                            <Border Height="36" Width="220" Background="#FFFFFF" HorizontalAlignment="Center">
                                <Canvas Width="210" Height="34" HorizontalAlignment="Center">
                                    <!-- Crisp Barcode Simulation Lines -->
                                    <Rectangle Canvas.Left="0" Width="3" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="5" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="8" Width="4" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="15" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="20" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="23" Width="3" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="29" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="34" Width="4" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="41" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="45" Width="3" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="51" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="56" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="60" Width="4" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="67" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="72" Width="3" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="78" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="82" Width="4" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="89" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="94" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="98" Width="3" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="104" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="109" Width="4" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="116" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="120" Width="3" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="126" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="131" Width="4" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="138" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="142" Width="3" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="148" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="153" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="157" Width="4" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="164" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="169" Width="3" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="175" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="179" Width="4" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="186" Width="2" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="191" Width="3" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="197" Width="1" Height="34" Fill="#0F172A"/>
                                    <Rectangle Canvas.Left="201" Width="3" Height="34" Fill="#0F172A"/>
                                </Canvas>
                            </Border>
                            <TextBlock x:Name="TxtBarcodeLabel" Text="* SM-20260926-0001 *" 
                                       FontFamily="Consolas" FontSize="10" Foreground="#475569" 
                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Footer Thank You Message -->
                        <TextBlock Text="THANK YOU FOR SHOPPING WITH US!" 
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0F172A" 
                                   HorizontalAlignment="Center" Margin="0,8,0,2"/>

                        <TextBlock Text="Please retain receipt for exchange within 7 days." 
                                   FontFamily="Consolas" FontSize="9" Foreground="#64748B" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Powered by Smart Mart POS ERP" 
                                   FontFamily="Consolas" FontSize="8" Foreground="#94A3B8" 
                                   HorizontalAlignment="Center" Margin="0,2,0,8"/>

                        <!-- Bottom Perforated Tear Indicator -->
                        <TextBlock Text="• • • • • • • • • • • • • • • • • • • • • • • • • • • • • • • • •" 
                                   Foreground="#94A3B8" HorizontalAlignment="Center" FontSize="9"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- 3. Bottom Action Controls Bar -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="0,0,16,16" Padding="18,14" BorderBrush="#334155" BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Status / Feedback Toast inside Window -->
                    <TextBlock x:Name="TxtStatus" Text="" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Print / Save as PDF Button -->
                        <Button Grid.Column="0" 
                                Click="Print_Click"
                                Background="#2563EB" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="12" 
                                Height="36" 
                                Padding="12,0" 
                                Margin="0,0,8,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="🖨️" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Print / PDF" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Save TXT Button -->
                        <Button Grid.Column="1" 
                                Click="SaveTxt_Click"
                                Background="#1E293B" 
                                Foreground="#F1F5F9" 
                                FontWeight="SemiBold" 
                                FontSize="11" 
                                Height="36" 
                                Padding="10,0" 
                                Margin="0,0,6,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#475569" BorderThickness="1" CornerRadius="8">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="💾" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Save TXT"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#334155"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Copy Plaintext Button -->
                        <Button Grid.Column="2" 
                                Click="CopyText_Click"
                                Background="#1E293B" 
                                Foreground="#F1F5F9" 
                                FontWeight="SemiBold" 
                                FontSize="11" 
                                Height="36" 
                                Padding="10,0" 
                                Margin="0,0,6,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#475569" BorderThickness="1" CornerRadius="8">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="📋" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Copy"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#334155"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Dismiss / Close Button -->
                        <Button Grid.Column="3" 
                                Click="Close_Click"
                                Background="#334155" 
                                Foreground="White" 
                                FontWeight="SemiBold" 
                                FontSize="11" 
                                Height="36" 
                                Padding="12,0" 
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="Close" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#475569"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
