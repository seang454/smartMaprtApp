<UserControl x:Class="SmallMartApp.UI.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmallMartApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProductListViewModel}"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Modern TextBox -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Top Header & Filter Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Add Product Card -->
            <RowDefinition Height="Auto"/>
            <!-- Status Alert (Auto) -->
            <RowDefinition Height="Auto"/>
            <!-- Product Data Table (Expands to fill full height) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 1. TOP HEADER & SEARCH / FILTER TOOLBAR                  -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦 " FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="Inventory &amp; Stock" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A"/>
                </StackPanel>
                <TextBlock Text="Manage products, adjust pricing, and monitor real-time stock levels" 
                           FontSize="12" Foreground="#64748B" Margin="28,2,0,0"/>
            </StackPanel>

            <!-- Search, Category Filter, Stock Filter, Sort, and Refresh -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" 
                        Padding="8,0" Width="180" Margin="0,0,8,0" Height="38">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" Margin="4,0,6,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 FontSize="12" Foreground="#0F172A"/>
                    </Grid>
                </Border>

                <!-- Category Dropdown Filter -->
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                          DisplayMemberPath="Name" Width="130" Height="38" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                <!-- Stock Level Filter -->
                <ComboBox ItemsSource="{Binding StockFilterOptions}" SelectedItem="{Binding StockFilter}" 
                          Width="130" Height="38" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                <!-- Sort By Dropdown -->
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" 
                          Width="140" Height="38" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>

                <!-- Reset Filters Button -->
                <Button Content="✕ Reset" Command="{Binding ResetFiltersCommand}" 
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#F1F5F9" Foreground="#475569" Height="38" Padding="10,0" Margin="0,0,8,0" FontSize="12"/>

                <!-- Refresh Button -->
                <Button Content="↻" Command="{Binding LoadProductsCommand}" 
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#2563EB" Foreground="White" Height="38" Padding="12,0" FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. QUICK ADD PRODUCT CARD                                -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1"
                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Card Header -->
                <TextBlock Grid.Row="0" Text="✨ Quick Add New Product" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                <!-- Form Fields in a Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Barcode -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="BARCODE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="PRODUCT NAME" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="CATEGORY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewProductCategory}" 
                                  DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Cost Price -->
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="COST ($)" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewCostPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToZeroConverter}, StringFormat='{}{0:F2}'}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Sell Price -->
                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                        <TextBlock Text="SELL ($)" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewSellPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToZeroConverter}, StringFormat='{}{0:F2}'}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Stock -->
                    <StackPanel Grid.Column="5" Margin="0,0,14,0">
                        <TextBlock Text="STOCK" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewStockQuantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToZeroConverter}}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Save Button -->
                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                        <Button Content="💾 Save Product" Command="{Binding AddProductCommand}" 
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#10B981" Foreground="White" Height="36" Padding="18,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. STATUS FEEDBACK NOTIFICATION                          -->
        <!-- ======================================================== -->
        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" 
                CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ️ " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- 4. MODERN INVENTORY DATA TABLE (FULL HEIGHT & WIDTH)     -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="0" 
                BorderBrush="#E2E8F0" BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Modern Styled ListView -->
                <ListView Grid.Row="0" ItemsSource="{Binding Products}" 
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <!-- Modern Header Style -->
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,12"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewColumnHeader">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Modern Row Style with hover effect -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                Padding="0,8">
                                            <GridViewRowPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0E7FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <!-- ID -->
                            <GridViewColumn Header="ID" Width="45">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}" Foreground="#94A3B8" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Barcode -->
                            <GridViewColumn Header="BARCODE" Width="115">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Barcode}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Product Name (Spacious) -->
                            <GridViewColumn Header="PRODUCT NAME" Width="210">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Category -->
                            <GridViewColumn Header="CATEGORY" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" CornerRadius="12" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category.Name, FallbackValue='Unassigned'}" 
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Cost Price -->
                            <GridViewColumn Header="COST" Width="75">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CostPrice, StringFormat='${0:F2}'}" FontSize="12" Foreground="#64748B"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Sell Price -->
                            <GridViewColumn Header="SELL PRICE" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SellPrice, StringFormat='${0:F2}'}" FontSize="13" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Stock Quantity -->
                            <GridViewColumn Header="STOCK" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StockQuantity}" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Status Badge -->
                            <GridViewColumn Header="STATUS" Width="105">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#DCFCE7" CornerRadius="12" Padding="8,2" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="● " FontSize="8" Foreground="#15803D" VerticalAlignment="Center"/>
                                                <TextBlock Text="In Stock" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Actions (Edit & Delete) -->
                            <GridViewColumn Header="ACTIONS" Width="85">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- Admin Buttons -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVisConverter}}">
                                                <!-- Edit Button -->
                                                <Button Command="{Binding DataContext.OpenEditProductCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}" 
                                                        Width="28" Height="28" Cursor="Hand" Margin="0,0,6,0"
                                                        ToolTip="Edit Product" Background="Transparent" BorderThickness="0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="EditBorder" Background="#EFF6FF" CornerRadius="6" Padding="4">
                                                                <TextBlock Text="✏️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="EditBorder" Property="Background" Value="#BFDBFE"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Delete Button -->
                                                <Button Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}" 
                                                        Width="28" Height="28" Cursor="Hand"
                                                        ToolTip="Delete Product" Background="Transparent" BorderThickness="0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="DelBorder" Background="#FEE2E2" CornerRadius="6" Padding="4">
                                                                <TextBlock Text="🗑️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="DelBorder" Property="Background" Value="#EF4444"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>

                                            <!-- Cashier Read-Only Badge -->
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ListView}}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="👁️ View" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 5. Pagination Bar -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Showing X-Y of Z entries -->
                        <TextBlock Grid.Column="0" Text="{Binding PaginationInfo}" 
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                        <!-- Page Size Selector -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Rows per page:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" 
                                      Width="65" Height="30" FontSize="12" VerticalContentAlignment="Center"
                                      Background="White" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- Navigation Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⏮" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                    Width="30" Height="30" Margin="0,0,4,0" ToolTip="First Page"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                            <Button Content="◀" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                    Width="30" Height="30" Margin="0,0,6,0" ToolTip="Previous Page"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                            
                            <Border Background="#EFF6FF" CornerRadius="6" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageDisplay}" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                            </Border>

                            <Button Content="▶" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"
                                    Width="30" Height="30" Margin="0,0,4,0" ToolTip="Next Page"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                            <Button Content="⏭" Command="{Binding LastPageCommand}" IsEnabled="{Binding CanNextPage}"
                                    Width="30" Height="30" ToolTip="Last Page"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155" Padding="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Edit Product Modal Dialog -->
        <Grid Grid.RowSpan="4" Background="#990F172A" 
              Visibility="{Binding IsEditProductOpen, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="1000">
            <Border Background="White" CornerRadius="14" Padding="28,24" Width="520" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#EFF6FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="✏️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Edit Product Details" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Modify pricing, stock quantities, and categorization" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="BARCODE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PRODUCT NAME" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="BUY/COST ($)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditCostPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToZeroConverter}, StringFormat='{}{0:F2}'}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="SELL PRICE ($)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditSellPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToZeroConverter}, StringFormat='{}{0:F2}'}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STOCK QTY" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditStockQuantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToZeroConverter}}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="CATEGORY" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding EditProductCategory}" 
                                  DisplayMemberPath="Name" Height="38" Background="White" BorderBrush="#CBD5E1" FontSize="13"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseEditProductCommand}"
                                Style="{StaticResource ModernButtonStyle}" 
                                Background="#F1F5F9" Foreground="#475569" Height="40" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="✓ Save Changes" Command="{Binding SaveEditProductCommand}"
                                Style="{StaticResource ModernButtonStyle}" 
                                Background="#2563EB" Foreground="White" Height="40" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
